---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const active = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F1F2EC" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Gloock&family=Hanken+Grotesk:wght@400;500;600;700&family=Bricolage+Grotesque:opsz,wght@12..96,700&family=Figtree:wght@700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Activa las animaciones de entrada. Si main.js no carga en 3 s, se quitan para que el contenido se vea igual.
      document.documentElement.classList.add('js');
      setTimeout(function () { if (!window.__k2Ready) document.documentElement.classList.remove('js'); }, 3000);
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <Header active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>import '../scripts/main.js';</script>
  </body>
</html>
