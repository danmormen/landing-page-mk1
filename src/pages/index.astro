---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MiniSite from '../components/MiniSite.astro';
import Mountain from '../components/Mountain.astro';
import Steps from '../components/Steps.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import CtaBand from '../components/CtaBand.astro';
import { BRAND, STEPS } from '../data/site';
import { byKey } from '../data/projects';

// Pestañas de la vitrina del hero
const showcase = [
  { label: 'Cafetería', project: byKey('cafe') },
  { label: 'Ferretería', project: byKey('ferre') },
  { label: 'Clínica dental', project: byKey('dental') },
  { label: 'Sistema de inventario', project: byKey('inv') },
];

const offer = [
  {
    icon: 'page', title: 'Páginas web para tu negocio', href: '/servicios#paginas',
    text: 'Desde una sola página hasta un sitio completo: tu negocio explicado con claridad y listo para recibir clientes.',
    points: ['Diseño a la medida de tu marca', 'Botón directo a WhatsApp', 'Se ve bien en el celular'],
  },
  {
    icon: 'sys', title: 'Sistemas a la medida', href: '/servicios#sistemas',
    text: 'Pedidos, citas, inventario y clientes en un solo lugar, para dejar el cuaderno y las hojas sueltas atrás.',
    points: ['Hecho para cómo trabajas', 'Fácil de usar para tu equipo', 'Reportes para decidir mejor'],
  },
] as const;

const values = [
  { title: 'Hecho a tu medida', text: 'Nada de plantillas: cada página y cada sistema parte de cómo funciona tu negocio.' },
  { title: 'Claro y sin tecnicismos', text: 'Te explicamos todo en tu idioma y siempre sabes en qué paso vamos.' },
  { title: 'Pensado para crecer', text: 'Empezamos con lo que necesitas hoy y dejamos todo listo para lo que viene.' },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---
<Base
  title={`${BRAND} · Páginas web y sistemas para negocios en crecimiento`}
  description="Diseñamos páginas web y sistemas a la medida para negocios pequeños y medianos que están creciendo."
>
  <section class="hero">
    <div class="wrap">
      <h1 class="display" data-hero="lead">Tu negocio, bien presentado y mejor organizado.</h1>
      <p class="lead" data-hero="sub">Diseñamos páginas web y sistemas a la medida para negocios que están creciendo. Tú nos cuentas cómo trabajas; nosotros lo convertimos en algo que funciona.</p>
      <div class="hero-ctas" data-hero="ctas">
        <a class="btn btn-primary" data-wa href="/contacto"><Icon name="chat" />Escríbenos por WhatsApp</a>
        <a class="btn btn-ghost" href="/servicios">Ver servicios</a>
      </div>
      <div class="tabs" role="tablist" aria-label="Ejemplos de proyectos" data-hero="deco">
        {showcase.map((s, i) => (
          <button class="tab" role="tab" id={`tab-${s.project.key}`} aria-controls={`site-${s.project.key}`} aria-selected={i === 0 ? 'true' : 'false'} data-url={s.project.url}>{s.label}</button>
        ))}
      </div>
      <div class="browser" data-hero="stage">
        <div class="browser-bar">
          <div class="dots" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="url"><Icon name="lock" /><span class="url-text">{showcase[0].project.url}</span></div>
          <span class="tag">Concepto</span>
        </div>
        <div class="screen">
          {showcase.map((s, i) => (
            <MiniSite site={s.project.key} id={`site-${s.project.key}`} role="tabpanel" aria-labelledby={`tab-${s.project.key}`} data-on={i === 0 ? '' : undefined} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section on-white">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2" data-reveal>Dos formas de ayudarte a crecer</h2>
        <p class="lead" data-reveal style="--d:90ms">Para cafeterías, ferreterías, clínicas, talleres, tiendas y cualquier negocio que ya tiene clientes y quiere dar el siguiente paso.</p>
      </div>
      <div class="offer two" data-stagger>
        {offer.map((o) => (
          <div class="offer-item" data-reveal>
            <div class="ico"><Icon name={o.icon} /></div>
            <h3 class="h3">{o.title}</h3>
            <p>{o.text}</p>
            <ul>{o.points.map((p) => <li><Icon name="check" /><span>{p}</span></li>)}</ul>
            <a class="arrow-link" href={o.href}>Ver más<Icon name="arrow" /></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section about" id="nosotros">
    <div class="wrap">
      <div class="about-grid">
        <div data-reveal>
          <h2 class="h2">Te ayudamos a subir al siguiente nivel</h2>
          <p>El K2 es la segunda montaña más alta del mundo y una de las más difíciles de escalar. Nadie llega a la cima de un salto: se sube por etapas, con buena preparación y con alguien que conoce el camino.</p>
          <p>Así trabajamos con los negocios. Entendemos dónde estás hoy, trazamos la ruta y construimos las herramientas para el siguiente tramo. Somos un estudio pequeño a propósito: hablas directo con quienes diseñan y programan tu proyecto.</p>
        </div>
        <div data-reveal style="--d:120ms"><Mountain /></div>
      </div>
      <ul class="values" data-stagger>
        {values.map((v) => <li data-reveal><h3>{v.title}</h3><p>{v.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2" data-reveal>Así trabajamos contigo</h2>
        <p class="lead" data-reveal style="--d:90ms">Sin tecnicismos y sin sorpresas: siempre sabes en qué paso vamos y qué sigue.</p>
      </div>
      <Steps items={STEPS} />
    </div>
  </section>

  <section class="section on-white">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2" data-reveal>Proyectos</h2>
        <div class="head-aside" data-reveal style="--d:90ms">
          <p class="lead">Conceptos que diseñamos para mostrar cómo resolvemos negocios distintos.</p>
          <a class="arrow-link" href="/portafolio">Ver todo el portafolio<Icon name="arrow" /></a>
        </div>
      </div>
      <div class="projects" data-stagger>
        <ProjectCard project={byKey('cafe')} />
        <ProjectCard project={byKey('dental')} />
        <ProjectCard project={byKey('inv')} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2" data-reveal>Del blog</h2>
        <div class="head-aside" data-reveal style="--d:90ms">
          <p class="lead">Ideas prácticas para que tu negocio crezca en internet.</p>
          <a class="arrow-link" href="/blog">Ver todos los artículos<Icon name="arrow" /></a>
        </div>
      </div>
      <div class="post-list flush" data-stagger>
        {posts.map((post) => <PostRow post={post} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
