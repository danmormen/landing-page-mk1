---
// Ilustración de la sección "Sobre nosotros": la montaña K2 con la ruta por etapas.
// La ruta se dibuja cuando la sección entra en pantalla (ver .mountain en global.css).
---
<svg class="mountain" viewBox="0 0 560 420" role="img" aria-label="Ilustración de una montaña con una ruta que sube por etapas: hoy, tu página web, tu sistema y el siguiente nivel.">
  <!-- cordillera de fondo -->
  <path d="M0 420V318l92-86 58 44 84-104 70 92 62-58 74 70 56-40 64 64v140z" fill="#23271A" />
  <!-- pico principal -->
  <path d="M24 420l148-176 46 34 84-208 52 92 34-22 148 280z" fill="#4C5A26" />
  <!-- cara en sombra -->
  <path d="M302 70l52 92 34-22 148 280H318l-8-140z" fill="#3A461C" />
  <!-- nieve -->
  <path d="M302 70l-27 66 19-10 15 18 13-24 14 14z" fill="#DCE2C6" />
  <!-- ruta: guía punteada + trazo que se dibuja -->
  <path class="route-guide" d="M78 400c64-16 106-40 126-78s52-56 60-96 30-62 34-104 4-50 4-50" fill="none" stroke="#DCE2C6" stroke-opacity=".28" stroke-width="2" stroke-dasharray="3 7" stroke-linecap="round" />
  <path class="route" pathLength="1" d="M78 400c64-16 106-40 126-78s52-56 60-96 30-62 34-104 4-50 4-50" fill="none" stroke="#DCE2C6" stroke-width="2.5" stroke-linecap="round" />
  <!-- campamentos -->
  <g class="camp" style="--i:0"><circle cx="78" cy="400" r="7" fill="#17190F" stroke="#DCE2C6" stroke-width="2.5" /><text x="96" y="405">Hoy</text></g>
  <g class="camp" style="--i:1"><circle cx="204" cy="322" r="7" fill="#17190F" stroke="#DCE2C6" stroke-width="2.5" /><text x="80" y="327" text-anchor="start">Tu página web</text></g>
  <g class="camp" style="--i:2"><circle cx="264" cy="226" r="7" fill="#17190F" stroke="#DCE2C6" stroke-width="2.5" /><text x="150" y="231">Tu sistema</text></g>
  <g class="camp summit" style="--i:3">
    <path d="M302 72V30" stroke="#DCE2C6" stroke-width="2.5" stroke-linecap="round" />
    <path d="M304 30l26 9-26 9z" fill="#DCE2C6" />
    <text x="338" y="46">El siguiente nivel</text>
  </g>
</svg>
