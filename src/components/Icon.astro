---
// Íconos SVG propios (trazo uniforme). Uso: <Icon name="arrow" />
interface Props { name: keyof typeof ICONS; class?: string; size?: number }

const ICONS = {
  chat: { sw: 1.8, d: '<path d="M4.5 19.5l1.2-3.6A7.5 7.5 0 1 1 8.4 18.6z"/><path d="M9.2 9.6c.2 1.9 1.8 3.8 3.9 4.6l1.2-1.1 1.8.9-.4 1.6c-3.6.2-7.3-3.3-7.4-6.9l1.5-.5.9 1.8z" fill="currentColor" stroke="none"/>' },
  mail: { sw: 1.8, d: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M4 7l8 6 8-6"/>' },
  page: { sw: 1.6, d: '<rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 9h18M7 13h6M7 16h4"/>' },
  site: { sw: 1.6, d: '<rect x="6" y="3" width="15" height="13" rx="2.5"/><path d="M3 8v10.5A2.5 2.5 0 0 0 5.5 21H16"/><path d="M6 7.5h15"/>' },
  sys: { sw: 1.6, d: '<rect x="3" y="4" width="7" height="7" rx="2"/><rect x="14" y="4" width="7" height="7" rx="2"/><rect x="3" y="15" width="7" height="5" rx="2"/><path d="M14 17.5h7M17.5 14v7"/>' },
  arrow: { sw: 2, d: '<path d="M5 12h14M13 6l6 6-6 6"/>' },
  back: { sw: 2, d: '<path d="M19 12H5M11 6l-6 6 6 6"/>' },
  check: { sw: 2.2, d: '<circle cx="12" cy="12" r="9.5" stroke-width="1.6"/><path d="M8 12.3l2.7 2.7L16 9.5"/>' },
  plus: { sw: 1.8, d: '<path d="M12 5v14M5 12h14"/>' },
  info: { sw: 1.8, d: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>' },
  lock: { sw: 2, d: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>' },
  search: { sw: 2, d: '<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>' },
  bars: { sw: 1.8, d: '<path d="M4 8h16M4 16h16"/>' },
  x: { sw: 1.8, d: '<path d="M6 6l12 12M18 6L6 18"/>' },
} as const;

const { name, class: className, size } = Astro.props;
const icon = ICONS[name];
---
<svg
  class={className}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={icon.sw}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icon.d}
/>
